# Copy to .env and fill in. The .env file is gitignored.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram: bot token from @BotFather; your numeric user id from @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:your-bot-token-here
TELEGRAM_OWNER_ID=111111111

# Postgres (matches docker-compose defaults)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=jobscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobscout

# Budget: hard daily cap on paid LLM calls (score + draft share this wallet)
MAX_LLM_CALLS_PER_DAY=40
MAX_SCORED_PER_RUN=25

# Google Sheet applications tracker (optional; empty = off).
# Setup: create a Google Cloud service account, enable the Sheets + Drive
# APIs, drop its JSON key at config/google_service_account.json (gitignored),
# share your spreadsheet with the service account email as Editor, and put
# the spreadsheet id (the long string in its URL) here. The bot owns columns
# A-J; add your own columns to the right - they are never touched.
GSHEET_ID=
GSHEET_TAB=Applications

# Pipeline
DRAFT_THRESHOLD=70
DIGEST_TOP_N=5
DIGEST_HOUR=8
DIGEST_MINUTE=30
SCOUT_HOUR=7
SCOUT_MINUTE=45
TIMEZONE=Europe/Sofia

LOG_LEVEL=INFO
