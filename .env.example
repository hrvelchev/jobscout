# Copy to .env and fill in. The .env file is gitignored.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram: bot token from @BotFather; your numeric user id from @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:your-bot-token-here
TELEGRAM_OWNER_ID=111111111

# Postgres (matches docker-compose defaults)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=jobscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobscout

# Budget: hard daily cap on paid LLM calls (score + draft share this wallet)
MAX_LLM_CALLS_PER_DAY=40
MAX_SCORED_PER_RUN=25

# Pipeline
DRAFT_THRESHOLD=70
DIGEST_TOP_N=5
DIGEST_HOUR=8
DIGEST_MINUTE=30
SCOUT_HOUR=7
SCOUT_MINUTE=45
TIMEZONE=Europe/Sofia

LOG_LEVEL=INFO
